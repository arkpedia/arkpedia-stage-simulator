{
  "name": "stronghold-protocol-alliance",
  "version": "0.1.3",
  "private": true,
  "description": "\u660e\u65e5\u65b9\u821f\u300c\u536b\u620d\u534f\u8bae\uff1a\u76df\u7ea6\u300d\u975e\u5b98\u65b9\u540c\u4eba\u8054\u673a\u7f51\u9875\u590d\u523b\uff081\u20134 \u4eba\u5408\u4f5c\uff0cNode.js \u670d\u52a1\u5668 + \u6d4f\u89c8\u5668\u5ba2\u6237\u7aef\uff09",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/sganggs/Stronghold-Protocol#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sganggs/Stronghold-Protocol.git"
  },
  "bugs": {
    "url": "https://github.com/sganggs/Stronghold-Protocol/issues"
  },
  "keywords": [
    "arknights",
    "auto-chess",
    "tower-defense",
    "co-op",
    "browser-game",
    "fan-game"
  ],
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test",
    "vendor": "node tools/vendor.mjs",
    "build-data": "node tools/build-data.mjs",
    "assets": "node tools/vendor.mjs && node tools/fetch-assets.mjs",
    "postinstall": "node tools/vendor.mjs",
    "setup": "node tools/setup.mjs",
    "doctor": "node tools/doctor.mjs",
    "launch": "node scripts/launch.mjs",
    "start:arkpedia": "node scripts/start-arkpedia.mjs",
    "build:arkpedia-data": "node tools/arkpedia/build-mvp.mjs --refresh",
    "coverage:arkpedia": "node tools/arkpedia/coverage.mjs",
    "audit:arkpedia-behaviors": "node tools/arkpedia/behavior-audit.mjs",
    "test:arkpedia": "node --test test/arkpedia-*.test.js",
    "check:arkpedia-enemies": "node tools/arkpedia/enemy-support.mjs --check",
    "check:arkpedia-stages": "node tools/arkpedia/stage-index.mjs --check",
    "coverage:arkpedia-stages": "node tools/arkpedia/stage-coverage.mjs",
    "bench:arkpedia": "node tools/arkpedia/benchmark-stage.mjs",
    "audit:arkpedia-devices": "node tools/arkpedia/device-audit.mjs",
    "coverage:arkpedia-assets": "node tools/arkpedia/asset-coverage.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "htm": "^3.1.1",
    "pixi-spine": "^4.0.6",
    "pixi.js": "^7.4.2",
    "preact": "^10.29.8",
    "three": "^0.186.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "puppeteer-core": "^25.12.0"
  }
}
