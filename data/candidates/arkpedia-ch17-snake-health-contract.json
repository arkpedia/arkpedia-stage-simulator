    "abilities": [
      {
        "text": "Becomes Invulnerable upon losing a certain amount of HP. Takes damage and becomes <$ba.stun>stunned</> if a special interaction is performed within this duration; otherwise recovers HP.",
        "format": "NORMAL"
      },
      {
        "text": "[Firewall] Has a Firewall around itself; takes greatly reduced Physical and Arts damage from outside the Firewall.",
        "format": "NORMAL"
      },
      {
        "text": "[Information Flood] Releases a flood of information in a fixed direction, causing the first unit hit to be <$ba.stun>stunned</> and continuously take True damage for a period of time.",
        "format": "NORMAL"
      },
      {
        "text": "[Halt Process] When a long time has passed in the battle, disappears and drains 50 Life Points.",
        "format": "NORMAL"
      },
      {
        "text": "Cannot be teleported",
        "format": "NORMAL"
      }
    ]
