  "scripts": {
    "Obt/Tutorial/Level/main_17-15_a": {
      "source": {
        "path": "cn/gamedata/story/obt/tutorial/level/main_17-15_a.txt",
        "bytes": 518,
        "gitBlob": "d3c89d9ae3a89fb6cd370884308a591221c4e7e1",
        "sha256": "9151b776ddd369232d61b00c650582ec8d85310e4b79886eb09c32254bb6f8f9"
      },
      "originalText": "[header(actId=\"main17\")]第17章演出关17-15a\n[camerafocusto(time=\"1\", scale=\"MID\", offsetX=3, offsetY=4)]\n[name=\"斯乔帕\", avatarId=\"char_4226_veen\"]我们已经不再属于第四集团军，这里没有人会再听从叶甫根尼的命令。\n[name=\"斯乔帕\", avatarId=\"char_4226_veen\"]“利沃诺夫号”的航向当然也不需要你们的指点。\n[name=\"斯乔帕\", avatarId=\"char_4226_veen\"]我用我的性命发誓，我要让“谢钦”……要让“自由民”，得到自由。\n[resetcamera]\n[end]",
      "instructions": [
        {
          "kind": "header",
          "actId": "main17"
        },
        {
          "kind": "cameraFocus",
          "duration": 1,
          "scale": "MID",
          "offsetX": 3,
          "offsetY": 4
        },
        {
          "kind": "dialogue",
          "name": "斯乔帕",
          "avatarId": "char_4226_veen",
          "text": "我们已经不再属于第四集团军，这里没有人会再听从叶甫根尼的命令。"
        },
        {
          "kind": "dialogue",
          "name": "斯乔帕",
          "avatarId": "char_4226_veen",
          "text": "“利沃诺夫号”的航向当然也不需要你们的指点。"
        },
        {
          "kind": "dialogue",
          "name": "斯乔帕",
          "avatarId": "char_4226_veen",
          "text": "我用我的性命发誓，我要让“谢钦”……要让“自由民”，得到自由。"
        },
        {
          "kind": "cameraReset"
        },
        {
          "kind": "end"
        }
      ]
    },
    "Obt/Tutorial/Level/main_17-15_b": {
      "source": {
        "path": "cn/gamedata/story/obt/tutorial/level/main_17-15_b.txt",
        "bytes": 900,
        "gitBlob": "02fda0e10df6a95a11444c2973baf90c80cd42c0",
        "sha256": "1a370f265ed825b758b1ad77b99b16999e1afdf6967ee1b7a61ae5a1f31ce7cf"
      },
      "originalText": "[header(actId=\"main17\")]第17章演出关17-15b\n[camerafocusto(time=\"1\", scale=\"MID\", offsetX=7, offsetY=4)]\n[name=\"战争术师\", avatarId=\"npc_10210_muwiza\"]你熟悉这里。你熟悉我们的行动模式，你曾是我们之中的一员——\n[name=\"战争术师\", avatarId=\"npc_10210_muwiza\"]……不，这不重要。“利沃诺夫号”必须继续前进。\n[name=\"战争术师\", avatarId=\"npc_10210_muwiza\"]到地狱里去与你的同伙们团聚吧，叛徒。而后，这里将由第四集团军全权接管。\n[camerafocusto(time=\"1\", scale=\"MID\", offsetX=3, offsetY=4)]\n[name=\"斯乔帕\", avatarId=\"char_4226_veen\"]“莫尔凡”不过是虚构的空间，你们最多只能重创我的意识，却杀不了我。\n[name=\"斯乔帕\", avatarId=\"char_4226_veen\"]究竟是谁去地狱，结果还未可知呢。\n[name=\"斯乔帕\", avatarId=\"char_4226_veen\"]别眨眼。\n[resetcamera]\n[end]",
      "instructions": [
        {
          "kind": "header",
          "actId": "main17"
        },
        {
          "kind": "cameraFocus",
          "duration": 1,
          "scale": "MID",
          "offsetX": 7,
          "offsetY": 4
        },
        {
          "kind": "dialogue",
          "name": "战争术师",
          "avatarId": "npc_10210_muwiza",
          "text": "你熟悉这里。你熟悉我们的行动模式，你曾是我们之中的一员——"
        },
        {
          "kind": "dialogue",
          "name": "战争术师",
          "avatarId": "npc_10210_muwiza",
          "text": "……不，这不重要。“利沃诺夫号”必须继续前进。"
        },
        {
          "kind": "dialogue",
          "name": "战争术师",
          "avatarId": "npc_10210_muwiza",
          "text": "到地狱里去与你的同伙们团聚吧，叛徒。而后，这里将由第四集团军全权接管。"
        },
        {
          "kind": "cameraFocus",
          "duration": 1,
          "scale": "MID",
          "offsetX": 3,
          "offsetY": 4
        },
        {
          "kind": "dialogue",
          "name": "斯乔帕",
          "avatarId": "char_4226_veen",
          "text": "“莫尔凡”不过是虚构的空间，你们最多只能重创我的意识，却杀不了我。"
        },
        {
          "kind": "dialogue",
          "name": "斯乔帕",
          "avatarId": "char_4226_veen",
          "text": "究竟是谁去地狱，结果还未可知呢。"
        },
        {
          "kind": "dialogue",
          "name": "斯乔帕",
          "avatarId": "char_4226_veen",
          "text": "别眨眼。"
        },
        {
          "kind": "cameraReset"
        },
        {
          "kind": "end"
        }
      ]
    },
